<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Furação"
    Width="300"
    SizeToContent="Height"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    FontFamily="Segoe UI">
    <!-- A casca da janela: três caixas (folga, saliência,
         workset) e o botão Furar. O script lê os valores no
         manipulador fora_click e fecha. Veja o Capítulo 7.1 do livro. -->
    <StackPanel Margin="16">
        <TextBlock Text="Furação automática"
                   FontWeight="Bold"
                   FontSize="13"
                   Margin="0,0,0,12"/>
        <DockPanel Margin="0,0,0,6">
            <TextBox x:Name="franco" Width="56" Text="25"
                     DockPanel.Dock="Right"
                     HorizontalContentAlignment="Right"/>
            <TextBlock Text="Folga radial (mm)"
                       VerticalAlignment="Center"/>
        </DockPanel>
        <DockPanel Margin="0,0,0,6">
            <TextBox x:Name="sporgenza" Width="56" Text="25"
                     DockPanel.Dock="Right"
                     HorizontalContentAlignment="Right"/>
            <TextBlock Text="Saliência além das faces (mm)"
                       VerticalAlignment="Center"/>
        </DockPanel>
        <DockPanel Margin="0,0,0,6">
            <TextBox x:Name="workset" Width="110" Text="FURAÇÃO"
                     DockPanel.Dock="Right"
                     HorizontalContentAlignment="Right"/>
            <TextBlock Text="Workset de colocação"
                       VerticalAlignment="Center"/>
        </DockPanel>
        <Button x:Name="fora"
                Content="Furar"
                Height="30"
                Margin="0,14,0,0"
                Click="fora_click"/>
    </StackPanel>
</Window>
