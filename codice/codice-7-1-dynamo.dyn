    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Le strutture del link vicine ai conduit scelti, nel nostro mondo.\n# La scrematura a scatole (Parte 6) vive qui: si convertono SOLO i\n# solidi che possono toccare i conduit, non tutto il link.\nimport clr\nclr.AddReference('RevitAPI')\nfrom Autodesk.Revit.DB import (FilteredElementCollector,\n    BuiltInCategory, Options, Solid, GeometryInstance, XYZ)\nclr.AddReference('RevitNodes')\nimport Revit\nclr.ImportExtensions(Revit.GeometryConversion)\n\nlink   = UnwrapElement(IN[0])          # RevitLinkInstance\nscelti = [UnwrapElement(e) for e in IN[1]]\nldoc = link.GetLinkDocument()\ntr   = link.GetTotalTransform()        # mondo del link -> il nostro\ninv  = tr.Inverse\ncs   = tr.ToCoordinateSystem()\n\ndef scatola(el, t=None):\n    bb = el.get_BoundingBox(None)\n    if bb is None:\n        return None\n    if t is None:\n        return (bb.Min.X, bb.Min.Y, bb.Min.Z,\n                bb.Max.X, bb.Max.Y, bb.Max.Z)\n    xs, ys, zs = [], [], []\n    for x in (bb.Min.X, bb.Max.X):\n        for y in (bb.Min.Y, bb.Max.Y):\n            for z in (bb.Min.Z, bb.Max.Z):\n                p = t.OfPoint(XYZ(x, y, z))\n                xs.append(p.X); ys.append(p.Y); zs.append(p.Z)\n    return (min(xs), min(ys), min(zs), max(xs), max(ys), max(zs))\n\ndef si_toccano(a, b, g=0.5):           # gioco in piedi (~15 cm)\n    return (a[0]-g <= b[3] and b[0]-g <= a[3] and\n            a[1]-g <= b[4] and b[1]-g <= a[4] and\n            a[2]-g <= b[5] and b[2]-g <= a[5])\n\n# le scatole dei conduit scelti, portate nel mondo del link\nscatole = [s for s in (scatola(el, inv) for el in scelti) if s]\n\nCATEGORIE = [BuiltInCategory.OST_Walls,\n             BuiltInCategory.OST_Floors,\n             BuiltInCategory.OST_StructuralFraming]\nsolidi, scartati = [], 0\nfor cat in CATEGORIE:\n    for el in (FilteredElementCollector(ldoc).OfCategory(cat)\n               .WhereElementIsNotElementType()):\n        b = scatola(el)\n        if b is None or not any(si_toccano(a, b) for a in scatole):\n            continue                   # lontano: non si converte\n        for g in el.get_Geometry(Options()):\n            pezzi = (g.GetInstanceGeometry()\n                     if isinstance(g, GeometryInstance) else [g])\n            for s in pezzi:\n                if isinstance(s, Solid) and s.Volume > 1e-6:\n                    # qualche faccia non sopravvive alla\n                    # conversione Revit -> Dynamo: si salta\n                    try:\n                        solidi.append(\n                            s.ToProtoType().Transform(cs))\n                    except Exception:\n                        scartati += 1\nOUT = solidi\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "NodeType": "PythonScriptNode",
      "Id": "04993560c715406cbb3be5ee4c3c5e84",
      "Inputs": [
        {
          "Id": "936441577ae04734853018ce284d6a3d",
