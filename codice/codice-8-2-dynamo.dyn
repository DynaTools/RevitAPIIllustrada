      ],
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "Demin = 1.3 * Dt;\nnorma = De >= Demin;\nprassi = K <= 0.40;\nesito = norma ? (prassi ? \"CONFORME\" : \"NO LIMITE\") : \"NÃO CONFORME\";\ncolore = norma\n    ? (prassi ? Color.ByARGB(255, 0, 150, 60)\n              : Color.ByARGB(255, 235, 160, 0))\n    : Color.ByARGB(255, 200, 30, 30);\nreport = [\"De mm = \" + Math.Round(De, 1),\n          \"Ocupação % = \" + Math.Round(K * 100, 1),\n          \"Dt mm = \" + Math.Round(Dt, 1),\n          \"min 1,3 x Dt mm = \" + Math.Round(Demin, 1),\n          \"RESULTADO: \" + esito];"
    },
